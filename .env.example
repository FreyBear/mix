# Dirigent-PIN (standard: 1234). Bytt denne i produksjon.
ADMIN_PIN=1234
# Valgfritt: hemmelighet for signering av innloggings-cookie
# SESSION_SECRET=bytt-meg
# Valgfritt: sti til SQLite-fil (standard: ./data/mixup.db)
# DATABASE_PATH=./data/mixup.db
# Sett til true hvis appen kjører bak HTTPS
# COOKIE_SECURE=true
# Sett til false for å hindre automatisk seeding av tom database
# SEED_ON_EMPTY=false
