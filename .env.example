# Dirigent-PIN (standard: 1234 ved første oppstart).
# Appen krever uansett at du setter et personlig passord ved 1. gangs innlogging.
ADMIN_PIN=1234

# Hemmelighet for signering av innloggings-cookie.
# Generer en tilfeldig nøkkel i terminalen med: openssl rand -hex 32
SESSION_SECRET=

# Sett til true når appen kjører bak HTTPS (f.eks. via Cloudflare Tunnel)
COOKIE_SECURE=true

# Sett til false hvis du vil starte med en tom database uten demodata
SEED_ON_EMPTY=true

